<!-- Navbar traslúcido flotante tipo Glassmorphism iOS -->
<nav class="navbar navbar-expand-lg educan-glass-nav fixed-top" id="mainNavbar">
  <div class="container-fluid container-xl">
    <!-- Logotipo -->
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <span class="brand-badge"><i class="bi bi-shield-check"></i></span>
      <span class="brand-text">EDU<span class="brand-accent">CAN</span></span>
    </a>

    <!-- Botón responsive hamburguesa -->
    <button class="navbar-toggler custom-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarEducan" aria-controls="navbarEducan" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Menú de Enlaces -->
    <div class="collapse navbar-collapse" id="navbarEducan">
      <ul class="navbar-nav mx-auto mb-2 mb-lg-0 nav-menu-list">
        <li class="nav-item">
          <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Inicio</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= currentPath === '/nosotros' ? 'active' : '' %>" href="/nosotros">Nosotros</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= currentPath === '/servicios' ? 'active' : '' %>" href="/servicios">Servicios</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= currentPath === '/tienda' ? 'active' : '' %>" href="/tienda">Tienda</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= currentPath === '/blog' ? 'active' : '' %>" href="/blog">Blog</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= currentPath === '/contacto' ? 'active' : '' %>" href="/contacto">Contacto</a>
        </li>
      </ul>

      <!-- Acciones de Usuario (Login / Sesión) -->
      <div class="d-flex align-items-center gap-3">
        <% if (currentUser) { %>
          <div class="dropdown">
            <button class="btn btn-nav-user dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <span class="user-avatar-circle"><i class="bi bi-person-fill"></i></span>
              <span class="d-none d-sm-inline"><%= currentUser.name %></span>
              <span class="badge bg-educan-olive rounded-pill"><%= currentUser.role %></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end educan-dropdown-menu">
              <li><h6 class="dropdown-header text-muted"><%= currentUser.email %></h6></li>
              <li><a class="dropdown-item" href="/dashboard"><i class="bi bi-speedometer2 me-2"></i> Mi Panel</a></li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <a class="dropdown-item text-danger" href="/auth/logout">
                  <i class="bi bi-box-arrow-right me-2"></i> Cerrar sesión
                </a>
              </li>
            </ul>
          </div>
        <% } else { %>
          <a href="/auth/login" class="btn btn-glass-login">
            <i class="bi bi-person me-1"></i> Iniciar sesión
          </a>
          <a href="/auth/register" class="btn btn-educan-primary d-none d-md-inline-flex">
            Registrarse
          </a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
