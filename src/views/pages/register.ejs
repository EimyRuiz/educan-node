<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-educan-beige auth-body">
  <!-- Navbar traslúcido -->
  <%- include('../partials/navbar') %>

  <main class="auth-wrapper d-flex align-items-center justify-content-center py-5">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-6">
          <!-- Tarjeta de Registro Glassmorphism -->
          <div class="auth-card p-4 p-sm-5 shadow-lg">
            <div class="text-center mb-4">
              <div class="auth-icon-badge mb-3 mx-auto">
                <i class="bi bi-person-plus-fill"></i>
              </div>
              <h2 class="auth-title fw-bold">Crear Cuenta</h2>
              <p class="text-muted small">Únete a la mayor red de adiestramiento y bienestar canino</p>
            </div>

            <!-- Alertas de error/éxito -->
            <%- include('../partials/alerts') %>

            <!-- Formulario de Registro -->
            <form action="/auth/register" method="POST" class="needs-validation" novalidate id="registerForm">
              <!-- Nombre completo -->
              <div class="form-floating mb-3">
                <input type="text" class="form-control auth-input" id="name" name="name" placeholder="Tu nombre" required>
                <label for="name"><i class="bi bi-person me-2"></i>Nombre completo</label>
                <div class="invalid-feedback">Por favor ingresa tu nombre.</div>
              </div>

              <!-- Correo electrónico -->
              <div class="form-floating mb-3">
                <input type="email" class="form-control auth-input" id="email" name="email" placeholder="correo@ejemplo.com" required>
                <label for="email"><i class="bi bi-envelope me-2"></i>Correo electrónico</label>
                <div class="invalid-feedback">Por favor ingresa un correo válido.</div>
              </div>

              <!-- Selector de Rol (3 roles: Cliente, Adiestrador, Administrador) -->
              <div class="form-floating mb-3">
                <select class="form-select auth-input" id="role" name="role" required>
                  <option value="Cliente" selected>Cliente (Propietario de perro)</option>
                  <option value="Adiestrador">Adiestrador (Entrenador certificado)</option>
                  <option value="Administrador">Administrador (Gestión EDUCAN)</option>
                </select>
                <label for="role"><i class="bi bi-person-badge me-2"></i>Tipo de perfil</label>
              </div>

              <div class="row g-2 mb-3">
                <!-- Contraseña -->
                <div class="col-sm-6">
                  <div class="form-floating">
                    <input type="password" class="form-control auth-input" id="password" name="password" placeholder="Contraseña" minlength="6" required>
                    <label for="password"><i class="bi bi-lock me-2"></i>Contraseña</label>
                    <div class="invalid-feedback">Mínimo 6 caracteres.</div>
                  </div>
                </div>

                <!-- Confirmar contraseña -->
                <div class="col-sm-6">
                  <div class="form-floating">
                    <input type="password" class="form-control auth-input" id="confirmPassword" name="confirmPassword" placeholder="Confirmar Contraseña" minlength="6" required>
                    <label for="confirmPassword"><i class="bi bi-check-circle me-2"></i>Confirmar</label>
                    <div class="invalid-feedback">Confirma tu contraseña.</div>
                  </div>
                </div>
              </div>

              <div class="form-check mb-4">
                <input class="form-check-input" type="checkbox" value="" id="termsCheck" required>
                <label class="form-check-label text-muted small" for="termsCheck">
                  Acepto los <a href="#" class="text-educan-olive text-decoration-none">Términos de Servicio</a> y la <a href="#" class="text-educan-olive text-decoration-none">Política de Privacidad</a>.
                </label>
                <div class="invalid-feedback">Debes aceptar los términos para continuar.</div>
              </div>

              <!-- Botón Submit -->
              <button type="submit" class="btn btn-educan-primary w-100 py-3 mb-3">
                <i class="bi bi-arrow-right-circle me-2"></i> Completar Registro
              </button>

              <div class="text-center">
                <span class="text-muted small">¿Ya tienes una cuenta registrada? </span>
                <a href="/auth/login" class="small fw-bold text-educan-olive text-decoration-none">
                  Inicia sesión aquí
                </a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
